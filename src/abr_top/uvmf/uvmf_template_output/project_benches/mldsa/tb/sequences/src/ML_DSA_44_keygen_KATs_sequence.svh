//----------------------------------------------------------------------
// Created with uvmf_gen version 2022.3
//----------------------------------------------------------------------
// pragma uvmf custom header begin
// pragma uvmf custom header end
//----------------------------------------------------------------------
//
// DESCRIPTION: ML-DSA-44 KeyGen known-answer test sequence.
// Exercises MLDSA_CTRL.PARAM_SET = 2'b01 and checks that the public and
// private key apertures return the FIPS 204 byte stream for the narrower
// parameter set, and that the unused tail of each aperture reads back zero.
//
// Expected values were produced with the vendored reference implementation
// (test_dilithium2) from the same seeds used by the category-5 KATs.
//
//----------------------------------------------------------------------

class ML_DSA_44_keygen_KATs_sequence extends mldsa_bench_sequence_base;

  `uvm_object_utils(ML_DSA_44_keygen_KATs_sequence);

  // MLDSA_CTRL encoding: CTRL[2:0] = 001 (KEYGEN), PARAM_SET[8:7] = 01
  localparam bit [31:0] MLDSA_CTRL_KEYGEN  = 32'h00000081;
  localparam bit [31:0] MLDSA_CTRL_ZEROIZE = 32'h0000_0008;

  mldsa_keygen_kat_t keygen_kats[];
  bit [31:0] kat_SEED [];
  bit ready;
  bit valid;

  function new(string name = "");
    super.new(name);
    keygen_kats = new[2];
    kat_SEED = new[8];
  endfunction

  virtual task body();
    reg_model.reset();
    #400;

    if (reg_model.default_map == null) begin
      `uvm_fatal("MAP_ERROR", "mldsa_uvm_rm.default_map map is not initialized");
    end else begin
      `uvm_info("MAP_INIT", "mldsa_uvm_rm.default_map is initialized", UVM_LOW);
    end

    keygen_kats[0].SEED        = "38359FBCD79582CFFE609E137EE2EFE8A8DBCBAD18BA92BB433AB4F09B49299D";
    keygen_kats[0].expected_PK = "";
    keygen_kats[0].expected_SK = "";

    keygen_kats[1].SEED        = "29B4987C62218C19C77D695EB904AFFAA1BFEF6A52F138604CDAB1534E66DC10";
    keygen_kats[1].expected_PK = "";
    keygen_kats[1].expected_SK = "";

    foreach (keygen_kats[i]) begin
      parse_hex_to_array(keygen_kats[i].SEED, kat_SEED);
      parse_hex_to_array(keygen_kats[i].expected_PK, PK);
      parse_hex_to_array(keygen_kats[i].expected_SK, SK);

      `uvm_info("KAT", $sformatf("Running ML-DSA-44 KeyGen KAT %0d", i), UVM_LOW);

      ready = 0;
      while (!ready) begin
        reg_model.MLDSA_STATUS.read(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_READ_FAIL", "Failed to read MLDSA_STATUS");
        end
        ready = data[0];
      end

      foreach (reg_model.MLDSA_SEED[j]) begin
        reg_model.MLDSA_SEED[j].write(status, kat_SEED[j], UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_WRITE_FAIL", $sformatf("Failed to write MLDSA_SEED[%0d] for KAT %0d", j, i));
        end
      end

      data = MLDSA_CTRL_KEYGEN;
      reg_model.MLDSA_CTRL.write(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
      if (status != UVM_IS_OK) begin
        `uvm_error("REG_WRITE_FAIL", "Failed to write MLDSA_CTRL to trigger KeyGen");
      end else begin
        `uvm_info("REG_WRITE_PASS", $sformatf("MLDSA_CTRL written with %0h (KEYGEN, PARAM_SET=01)", data), UVM_LOW);
      end

      valid = 0;
      while (!valid) begin
        reg_model.MLDSA_STATUS.read(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_READ", "Failed to read MLDSA_STATUS");
        end
        if (data[3]) begin
          `uvm_fatal("MLDSA_ERROR", $sformatf("MLDSA_STATUS.ERROR asserted for ML-DSA-44 KeyGen (status=%0h).", data));
        end
        valid = data[1];
      end

      // Public key: first PK.size() dwords must match, remainder must read zero.
      for (int j = 0; j < reg_model.MLDSA_PUBKEY.m_mem.get_size(); j++) begin
        reg_model.MLDSA_PUBKEY.m_mem.read(status, j, data, UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_READ_FAIL", $sformatf("Failed to read MLDSA_PUBKEY[%0d] for KAT %0d", j, i));
        end else if (j < PK.size()) begin
          if (data !== PK[j])
            `uvm_error("KAT_MISMATCH", $sformatf("PK mismatch for KAT %0d at index %0d: expected %h, got %h", i, j, PK[j], data));
        end else begin
          if (data !== 32'h0)
            `uvm_error("TAIL_NOT_ZERO", $sformatf("MLDSA_PUBKEY[%0d] is past the ML-DSA-44 key length but reads 0x%08h", j, data));
        end
      end

      // Private key: first SK.size() dwords must match, remainder must read zero.
      for (int j = 0; j < reg_model.MLDSA_PRIVKEY_OUT.m_mem.get_size(); j++) begin
        reg_model.MLDSA_PRIVKEY_OUT.m_mem.read(status, j, data, UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_READ_FAIL", $sformatf("Failed to read MLDSA_PRIVKEY_OUT[%0d] for KAT %0d", j, i));
        end else if (j < SK.size()) begin
          if (data !== SK[j])
            `uvm_error("KAT_MISMATCH", $sformatf("SK mismatch for KAT %0d at index %0d: expected %h, got %h", i, j, SK[j], data));
        end else begin
          if (data !== 32'h0)
            `uvm_error("TAIL_NOT_ZERO", $sformatf("MLDSA_PRIVKEY_OUT[%0d] is past the ML-DSA-44 key length but reads 0x%08h", j, data));
        end
      end

      data = MLDSA_CTRL_ZEROIZE;
      reg_model.MLDSA_CTRL.write(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
      if (status != UVM_IS_OK) begin
        `uvm_error("REG_WRITE", "Failed to write MLDSA_CTRL");
      end
    end

    `uvm_info("KAT", "ML-DSA-44 KeyGen KAT validation completed", UVM_LOW);

  endtask

endclass

// pragma uvmf custom external begin
// pragma uvmf custom external end
