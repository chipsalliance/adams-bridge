//----------------------------------------------------------------------
// Created with uvmf_gen version 2022.3
//----------------------------------------------------------------------
// pragma uvmf custom header begin
// pragma uvmf custom header end
//----------------------------------------------------------------------
//
// DESCRIPTION: ML-KEM-512 encapsulation and decapsulation known-answer tests.
//
// The round-trip tests (ML_KEM_512_kg_encaps_decaps_test) only prove that the
// hardware agrees with itself. Decapsulation re-runs encapsulation for the
// Fujisaki-Okamoto check, so any defect applied symmetrically to both is
// invisible to them -- exactly how the encapsulation error terms were drawn
// with eta_1 instead of eta_2 at ML-KEM-512 while every round trip reported
// zero errors. These vectors were produced independently by the FIPS 203
// reference model in src/abr_top/uvmf/ML_KEM_ref and pin the hardware to the
// standard rather than to itself.
//
// Three groups are checked:
//   1. Encapsulation: (ek, m) -> (c, K), plus the ciphertext aperture tail.
//   2. Decapsulation: (dk, c) -> K for a well formed ciphertext.
//   3. Implicit rejection: (dk, corrupted c) -> J(z || c), which is the only
//      directed check of the implicit-rejection hash path.
//
//----------------------------------------------------------------------

typedef struct {
  string ek;
  string dk;
  string msg;
  string ciphertext;
  string shared_key;
} mlkem_512_kat_t;

class ML_KEM_512_encaps_decaps_KATs_sequence extends mldsa_bench_sequence_base;

  `uvm_object_utils(ML_KEM_512_encaps_decaps_KATs_sequence);

  // MLKEM_CTRL: CTRL[2:0] = 010 encaps, 011 decaps, 1000 zeroize.
  // PARAM_SET[5:4] = 01 (ML-KEM-512).
  localparam bit [31:0] MLKEM_CTRL_PARAM_ONLY = 32'h0000_0010;
  localparam bit [31:0] MLKEM_CTRL_ENCAPS     = 32'h0000_0012;
  localparam bit [31:0] MLKEM_CTRL_DECAPS     = 32'h0000_0013;
  localparam bit [31:0] MLKEM_CTRL_ZEROIZE    = 32'h0000_0008;

  localparam int EK_DWORDS = 200;
  localparam int DK_DWORDS = 408;
  localparam int CT_DWORDS = 192;

  mlkem_512_kat_t encaps_kats[];
  mlkem_512_kat_t decaps_kats[];
  bit [31:0] kat_ek [];
  bit [31:0] kat_dk [];
  bit [31:0] kat_msg [];
  bit [31:0] kat_ct [];
  bit [31:0] kat_ss [];
  bit ready;
  bit valid;

  function new(string name = "");
    super.new(name);
    encaps_kats = new[2];
    decaps_kats = new[3];
  endfunction

  // The parameter set latch returns to its ML-KEM-1024 reset value on zeroize,
  // and the encapsulation-key and ciphertext apertures use the latched set to
  // decide where each key splits between memory and the scratch registers. The
  // parameter set must therefore be programmed before any aperture write, not
  // merely as part of the command that starts the operation. A CTRL write with
  // the command field zero latches the set without starting anything.
  task automatic program_param_set();
    reg_model.MLKEM_CTRL.write(status, MLKEM_CTRL_PARAM_ONLY, UVM_FRONTDOOR, reg_model.default_map, this);
    if (status != UVM_IS_OK)
      `uvm_error("REG_WRITE_FAIL", "Failed to program MLKEM_CTRL.PARAM_SET");
  endtask

  task automatic wait_ready();
    ready = 0;
    while (!ready) begin
      reg_model.MLKEM_STATUS.read(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
      if (status != UVM_IS_OK)
        `uvm_error("REG_READ_FAIL", "Failed to read MLKEM_STATUS");
      ready = data[0];
    end
  endtask

  task automatic wait_valid(string what);
    valid = 0;
    while (!valid) begin
      reg_model.MLKEM_STATUS.read(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
      if (status != UVM_IS_OK)
        `uvm_error("REG_READ_FAIL", "Failed to read MLKEM_STATUS");
      if (data[2])
        `uvm_fatal("MLKEM_ERROR", $sformatf("MLKEM_STATUS.ERROR asserted during %s (status=%0h). ML-KEM-512 likely not enabled at elaboration.", what, data));
      valid = data[1];
    end
  endtask

  // A truncated or mis-pasted KAT string would otherwise surface as hundreds of
  // comparison mismatches; report it once, at its cause.
  function automatic void check_size(string what, int got, int expected, int idx);
    if (got != expected)
      `uvm_fatal("KAT_MALFORMED", $sformatf("KAT %0d %s vector is %0d dwords, expected %0d", idx, what, got, expected))
  endfunction

  task automatic zeroize();
    reg_model.MLKEM_CTRL.write(status, MLKEM_CTRL_ZEROIZE, UVM_FRONTDOOR, reg_model.default_map, this);
    if (status != UVM_IS_OK)
      `uvm_error("REG_WRITE_FAIL", "Failed to write MLKEM_CTRL zeroize");
  endtask

  virtual task body();
    reg_model.reset();
    #400;

    if (reg_model.default_map == null) begin
      `uvm_fatal("MAP_ERROR", "mldsa_uvm_rm.default_map map is not initialized");
    end else begin
      `uvm_info("MAP_INIT", "mldsa_uvm_rm.default_map is initialized", UVM_LOW);
    end

    // Encapsulation vector 0
    encaps_kats[0].ek = "";
    encaps_kats[0].msg = "825FFA428751606898CEB028EE0CD7B5A9D46C6FC860DD1451B05A02C6BA2CC9";
    encaps_kats[0].ciphertext = "";
    encaps_kats[0].shared_key = "EE86690B9776AB0CF8EFD9AAD66695A637CA2FF41730C0A466E796655F6D5724";

    // Encapsulation vector 1
    encaps_kats[1].ek = "";
    encaps_kats[1].msg = "D35568DB298DFDCF1CEF646BBB76D3AEA594E2F8B237E8A354771A2615ADBC75";
    encaps_kats[1].ciphertext = "";
    encaps_kats[1].shared_key = "E7F6CF6D42224E2E980AA178AB0735B507BD85CDAA1582EC407D8F92AC46812E";

    // Decapsulation vector 0 (well formed ciphertext)
    decaps_kats[0].dk = "";
    decaps_kats[0].ciphertext = "";
    decaps_kats[0].shared_key = "EE86690B9776AB0CF8EFD9AAD66695A637CA2FF41730C0A466E796655F6D5724";

    // Decapsulation vector 1 (well formed ciphertext)
    decaps_kats[1].dk = "";
    decaps_kats[1].ciphertext = "";
    decaps_kats[1].shared_key = "E7F6CF6D42224E2E980AA178AB0735B507BD85CDAA1582EC407D8F92AC46812E";

    // Decapsulation vector 2: ciphertext corrupted in its first byte.
    // The expected shared key is the implicit-rejection value J(z || c),
    // so this is a known-answer check of the rejection hash path.
    decaps_kats[2].dk = "";
    decaps_kats[2].ciphertext = "";
    decaps_kats[2].shared_key = "D8D81CEC5FF1521EC01B1CB4DBD7DF3CB0BEE3DF1D698755A374D31CFA4126E4";

    //------------------------------------------------------------------
    // Encapsulation KATs: (ek, m) -> (c, K)
    //------------------------------------------------------------------
    foreach (encaps_kats[i]) begin
      parse_hex_to_array(encaps_kats[i].ek,         kat_ek);
      parse_hex_to_array(encaps_kats[i].msg,        kat_msg);
      parse_hex_to_array(encaps_kats[i].ciphertext, kat_ct);
      parse_hex_to_array(encaps_kats[i].shared_key, kat_ss);
      check_size("ek",         kat_ek.size(), EK_DWORDS, i);
      check_size("ciphertext", kat_ct.size(), CT_DWORDS, i);
      check_size("shared_key", kat_ss.size(), 8,         i);

      `uvm_info("KAT", $sformatf("Running ML-KEM-512 Encaps KAT %0d", i), UVM_LOW);
      wait_ready();
      program_param_set();

      for (int j = 0; j < EK_DWORDS; j++) begin
        reg_model.MLKEM_ENCAPS_KEY.m_mem.write(status, j, kat_ek[j], UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK)
          `uvm_error("REG_WRITE_FAIL", $sformatf("Failed to write MLKEM_ENCAPS_KEY[%0d]", j));
      end

      for (int j = 0; j < reg_model.MLKEM_MSG.m_mem.get_size(); j++) begin
        reg_model.MLKEM_MSG.m_mem.write(status, j, kat_msg[j], UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK)
          `uvm_error("REG_WRITE_FAIL", $sformatf("Failed to write MLKEM_MSG[%0d]", j));
      end

      reg_model.MLKEM_CTRL.write(status, MLKEM_CTRL_ENCAPS, UVM_FRONTDOOR, reg_model.default_map, this);
      if (status != UVM_IS_OK)
        `uvm_error("REG_WRITE_FAIL", "Failed to write MLKEM_CTRL to trigger Encaps");
      wait_valid("ML-KEM-512 encapsulation");

      foreach (reg_model.MLKEM_SHARED_KEY[j]) begin
        reg_model.MLKEM_SHARED_KEY[j].read(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_READ_FAIL", $sformatf("Failed to read MLKEM_SHARED_KEY[%0d]", j))
        end else if (data !== kat_ss[j]) begin
          `uvm_error("KAT_MISMATCH", $sformatf("Encaps KAT %0d SHARED_KEY[%0d]: actual=0x%08h expected=0x%08h", i, j, data, kat_ss[j]))
        end
      end

      // Active ciphertext must match the reference; the aperture tail beyond
      // the ML-KEM-512 ciphertext length must read as zero.
      for (int j = 0; j < reg_model.MLKEM_CIPHERTEXT.m_mem.get_size(); j++) begin
        reg_model.MLKEM_CIPHERTEXT.m_mem.read(status, j, data, UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_READ_FAIL", $sformatf("Failed to read MLKEM_CIPHERTEXT[%0d]", j));
        end else if (j < CT_DWORDS) begin
          if (data !== kat_ct[j])
            `uvm_error("KAT_MISMATCH", $sformatf("Encaps KAT %0d CIPHERTEXT[%0d]: actual=0x%08h expected=0x%08h", i, j, data, kat_ct[j]));
        end else begin
          if (data !== 32'h0)
            `uvm_error("TAIL_NOT_ZERO", $sformatf("MLKEM_CIPHERTEXT[%0d] is past the ML-KEM-512 ciphertext length but reads 0x%08h", j, data));
        end
      end

      zeroize();
    end

    //------------------------------------------------------------------
    // Decapsulation KATs. The last vector carries a corrupted ciphertext
    // and its expected shared key is the implicit-rejection value
    // J(z || c), so the rejection hash path is checked against a known
    // answer rather than only against the hardware's own encapsulation.
    //------------------------------------------------------------------
    foreach (decaps_kats[i]) begin
      parse_hex_to_array(decaps_kats[i].dk,         kat_dk);
      parse_hex_to_array(decaps_kats[i].ciphertext, kat_ct);
      parse_hex_to_array(decaps_kats[i].shared_key, kat_ss);
      check_size("dk",         kat_dk.size(), DK_DWORDS, i);
      check_size("ciphertext", kat_ct.size(), CT_DWORDS, i);
      check_size("shared_key", kat_ss.size(), 8,         i);

      `uvm_info("KAT", $sformatf("Running ML-KEM-512 Decaps KAT %0d", i), UVM_LOW);
      wait_ready();
      program_param_set();

      for (int j = 0; j < DK_DWORDS; j++) begin
        reg_model.MLKEM_DECAPS_KEY.m_mem.write(status, j, kat_dk[j], UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK)
          `uvm_error("REG_WRITE_FAIL", $sformatf("Failed to write MLKEM_DECAPS_KEY[%0d]", j));
      end

      for (int j = 0; j < CT_DWORDS; j++) begin
        reg_model.MLKEM_CIPHERTEXT.m_mem.write(status, j, kat_ct[j], UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK)
          `uvm_error("REG_WRITE_FAIL", $sformatf("Failed to write MLKEM_CIPHERTEXT[%0d]", j));
      end

      reg_model.MLKEM_CTRL.write(status, MLKEM_CTRL_DECAPS, UVM_FRONTDOOR, reg_model.default_map, this);
      if (status != UVM_IS_OK)
        `uvm_error("REG_WRITE_FAIL", "Failed to write MLKEM_CTRL to trigger Decaps");
      wait_valid("ML-KEM-512 decapsulation");

      foreach (reg_model.MLKEM_SHARED_KEY[j]) begin
        reg_model.MLKEM_SHARED_KEY[j].read(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_READ_FAIL", $sformatf("Failed to read MLKEM_SHARED_KEY[%0d]", j))
        end else if (data !== kat_ss[j]) begin
          `uvm_error("KAT_MISMATCH", $sformatf("Decaps KAT %0d SHARED_KEY[%0d]: actual=0x%08h expected=0x%08h", i, j, data, kat_ss[j]))
        end
      end

      zeroize();
    end

    `uvm_info("KAT", "ML-KEM-512 encaps/decaps KAT validation completed", UVM_LOW);

  endtask

endclass

// pragma uvmf custom external begin
// pragma uvmf custom external end
