//----------------------------------------------------------------------
// Created with uvmf_gen version 2022.3
//----------------------------------------------------------------------
// pragma uvmf custom header begin
// pragma uvmf custom header end
//----------------------------------------------------------------------
//
// DESCRIPTION: ML-KEM-512 KeyGen known-answer test sequence.
// Exercises MLKEM_CTRL.PARAM_SET = 2'b01 and checks that the encapsulation
// and decapsulation key apertures return the FIPS 203 byte stream for the
// narrower parameter set, and that the unused tail of each aperture reads
// back as zero.
//
//----------------------------------------------------------------------

class ML_KEM_512_keygen_KATs_sequence extends mldsa_bench_sequence_base;

  `uvm_object_utils(ML_KEM_512_keygen_KATs_sequence);

  // MLKEM_CTRL encoding: CTRL[2:0] = 001 (KEYGEN), PARAM_SET[5:4] = 01
  localparam bit [31:0] MLKEM_CTRL_KEYGEN = 32'h0000_0011;
  localparam bit [31:0] MLKEM_CTRL_ZEROIZE = 32'h0000_0008;

  mlkem_keygen_kat_t keygen_kats[];
  bit [31:0] kat_seed_d [];
  bit [31:0] kat_seed_z [];
  bit ready;
  bit valid;

  function new(string name = "");
    super.new(name);
    keygen_kats = new[2];
    kat_seed_d = new[8];
    kat_seed_z = new[8];
  endfunction

  virtual task body();
    reg_model.reset();
    #400;

    if (reg_model.default_map == null) begin
      `uvm_fatal("MAP_ERROR", "mldsa_uvm_rm.default_map map is not initialized");
    end else begin
      `uvm_info("MAP_INIT", "mldsa_uvm_rm.default_map is initialized", UVM_LOW);
    end

    keygen_kats[0].seed_d     = "2CB843A02EF02EE109305F39119FABF49AB90A57FFECB3A0E75E179450F52761";
    keygen_kats[0].seed_z     = "84CC9121AE56FBF39E67ADBD83AD2D3E3BB80843645206BDD9F2F629E3CC49B7";
    keygen_kats[0].expected_PK = "";
    keygen_kats[0].expected_SK = "";

    keygen_kats[1].seed_d     = "9EFF3FF8252400827F3B4389E4EC07E67948257C744278048C889D0789C5BFFA";
    keygen_kats[1].seed_z     = "5D473027666FECF7024ABAF175B9BC42E84768C00AE2C5CF27A668121B02CD3A";
    keygen_kats[1].expected_PK = "";
    keygen_kats[1].expected_SK = "";

    foreach (keygen_kats[i]) begin
      parse_hex_to_array(keygen_kats[i].seed_d, kat_seed_d);
      parse_hex_to_array(keygen_kats[i].seed_z, kat_seed_z);
      parse_hex_to_array(keygen_kats[i].expected_PK, PK);
      parse_hex_to_array(keygen_kats[i].expected_SK, SK);

      `uvm_info("KAT", $sformatf("Running ML-KEM-512 KeyGen KAT %0d", i), UVM_LOW);

      ready = 0;
      while (!ready) begin
        reg_model.MLKEM_STATUS.read(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_READ_FAIL", "Failed to read MLKEM_STATUS");
        end
        ready = data[0];
      end

      foreach (reg_model.MLKEM_SEED_D[j]) begin
        reg_model.MLKEM_SEED_D[j].write(status, kat_seed_d[j], UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_WRITE_FAIL", $sformatf("Failed to write MLKEM_SEED_D[%0d] for KAT %0d", j, i));
        end
      end

      foreach (reg_model.MLKEM_SEED_Z[j]) begin
        reg_model.MLKEM_SEED_Z[j].write(status, kat_seed_z[j], UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_WRITE_FAIL", $sformatf("Failed to write MLKEM_SEED_Z[%0d] for KAT %0d", j, i));
        end
      end

      data = MLKEM_CTRL_KEYGEN;
      reg_model.MLKEM_CTRL.write(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
      if (status != UVM_IS_OK) begin
        `uvm_error("REG_WRITE_FAIL", "Failed to write MLKEM_CTRL to trigger KeyGen");
      end else begin
        `uvm_info("REG_WRITE_PASS", $sformatf("MLKEM_CTRL written with %0h (KEYGEN, PARAM_SET=01)", data), UVM_LOW);
      end

      valid = 0;
      while (!valid) begin
        reg_model.MLKEM_STATUS.read(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_READ", "Failed to read MLKEM_STATUS");
        end
        if (data[2]) begin
          `uvm_fatal("MLKEM_ERROR", $sformatf("MLKEM_STATUS.ERROR asserted for ML-KEM-512 KeyGen (status=%0h). Parameter set likely not enabled at elaboration.", data));
        end
        valid = data[1];
      end

      // Encapsulation key: first PK.size() dwords must match, remainder must be zero.
      for (int j = 0; j < reg_model.MLKEM_ENCAPS_KEY.m_mem.get_size(); j++) begin
        reg_model.MLKEM_ENCAPS_KEY.m_mem.read(status, j, data, UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_READ", $sformatf("Failed to read MLKEM_ENCAPS_KEY[%0d]", j));
        end else if (j < PK.size()) begin
          if (PK[j] != data)
            `uvm_error("KAT_MISMATCH", $sformatf("MLKEM_ENCAPS_KEY[%0d] mismatch: actual=0x%08h, expected=0x%08h", j, data, PK[j]));
        end else begin
          if (data != 32'h0)
            `uvm_error("TAIL_NOT_ZERO", $sformatf("MLKEM_ENCAPS_KEY[%0d] is past the ML-KEM-512 key length but reads 0x%08h", j, data));
        end
      end

      // Decapsulation key: first SK.size() dwords must match, remainder must be zero.
      for (int j = 0; j < reg_model.MLKEM_DECAPS_KEY.m_mem.get_size(); j++) begin
        reg_model.MLKEM_DECAPS_KEY.m_mem.read(status, j, data, UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_READ", $sformatf("Failed to read MLKEM_DECAPS_KEY[%0d]", j));
        end else if (j < SK.size()) begin
          if (SK[j] != data)
            `uvm_error("KAT_MISMATCH", $sformatf("MLKEM_DECAPS_KEY[%0d] mismatch: actual=0x%08h, expected=0x%08h", j, data, SK[j]));
        end else begin
          if (data != 32'h0)
            `uvm_error("TAIL_NOT_ZERO", $sformatf("MLKEM_DECAPS_KEY[%0d] is past the ML-KEM-512 key length but reads 0x%08h", j, data));
        end
      end

      data = MLKEM_CTRL_ZEROIZE;
      reg_model.MLKEM_CTRL.write(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
      if (status != UVM_IS_OK) begin
        `uvm_error("REG_WRITE", "Failed to write MLKEM_CTRL");
      end
    end

    `uvm_info("KAT", "ML-KEM-512 KeyGen KAT validation completed", UVM_LOW);

  endtask

endclass

// pragma uvmf custom external begin
// pragma uvmf custom external end
