class ML_DSA_65_keygen_signing_KATs_sequence extends mldsa_bench_sequence_base;

  `uvm_object_utils(ML_DSA_65_keygen_signing_KATs_sequence);

  // MLDSA_CTRL: CTRL[2:0] = 100 KEYGEN+SIGN / 011 VERIFY, PARAM_SET[8:7] = 2'b10
  localparam bit [31:0] MLDSA_CTRL_KEYGEN_SIGN = 32'h00000104;
