      check_size("seed",      kat_SEED_arr.size(), 8);
      check_size("message",   kat_MSG_arr.size(),  16);
      check_size("pk",        kat_PK_arr.size(),   PK_DWORDS);
      check_size("signature", kat_SIG_arr.size(),  SIG_DWORDS);
      check_size("c~",        kat_VRES_arr.size(), 16);

