    kat_SEED[2] = "ECE36C85ACBF0B76353C35857E38BA47BB14AC4A61EA1D306EA3B8534E785E42";
    kat_MSG[2]  = "DBFD3890ED40FBB371270C9CBFAB5B9B93FA0EDA7832867DE0B735E6166D6A4D1F51B4A456AFD04A9133F3604C0511A43E721430CD9D2C2030592CEE4F06ED8A";
