            `uvm_error("VALIDATION_FAIL", $sformatf("ML-DSA-65 KAT %0d: VERIFY_RES[%0d] vs reference c~ mismatch: actual=0x%08h, expected=0x%08h", ki, j, data, kat_VRES_arr[j]))
          end
