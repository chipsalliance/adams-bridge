            `uvm_error("VALIDATION_FAIL", $sformatf("ML-DSA-65 KAT %0d: VERIFY_RES[%0d] vs hw signature mismatch: actual=0x%08h, expected=0x%08h", ki, j, data, hw_sig_arr[j]))
          end
        end else if (data !== 32'h0) begin
          `uvm_error("CTILDE_TAIL_NOT_ZERO", $sformatf("MLDSA_VERIFY_RES[%0d] is above the ML-DSA-65 c~ length but reads 0x%08h", j, data))
        end
      end

      // kat_VRES_arr is c~ zero extended to the category-5 register width,
      // which is exactly what MLDSA_VERIFY_RES should present here.
