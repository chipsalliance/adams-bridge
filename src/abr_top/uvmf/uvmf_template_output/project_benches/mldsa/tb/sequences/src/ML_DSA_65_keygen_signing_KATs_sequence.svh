    for (int ki = 0; ki < 3; ki++) begin
      `uvm_info("KAT", $sformatf("Running ML-DSA-65 internal-mu keygen+sign KAT %0d of 3", ki), UVM_LOW);

      parse_hex_to_array(kat_SEED[ki], kat_SEED_arr);
      parse_hex_to_array(kat_MSG[ki],  kat_MSG_arr);
      parse_hex_to_array(kat_PK[ki],   kat_PK_arr);
