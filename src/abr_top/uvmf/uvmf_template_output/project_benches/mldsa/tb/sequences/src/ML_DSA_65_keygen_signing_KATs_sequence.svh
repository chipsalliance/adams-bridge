    end

    kat_SEED[0] = "1B78786FA69400604CFBA9337900AA801B1271741641320EE51877BA19E9F8C0";
    kat_MSG[0]  = "4025C78183EFB61296985ECABA5DBBC63F061D7636A400A1BD99C8B782B81C1EEB962DFDCF3711F4AE10DA2F0240FAA4AA10A814D794BE0DAA2EFBE7005BECA4";
