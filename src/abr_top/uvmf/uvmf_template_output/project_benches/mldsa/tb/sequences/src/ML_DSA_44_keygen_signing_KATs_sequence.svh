        reg_model.MLDSA_STATUS.read(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) `uvm_error("REG_READ", "Failed to read MLDSA_STATUS");
        if (data[3]) begin
          `uvm_fatal("MLDSA_ERROR", $sformatf("MLDSA_STATUS.ERROR asserted for ML-DSA-44 verify (status=%0h)", data))
        end
        valid = data[1];
      end

      foreach (reg_model.MLDSA_VERIFY_RES[j]) begin
        reg_model.MLDSA_VERIFY_RES[j].read(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) begin
          `uvm_error("REG_READ", $sformatf("Failed to read MLDSA_VERIFY_RES[%0d]", j))
        end else if (j < CTILDE_DWORDS) begin
          if (data !== kat_VRES_arr[j]) begin
            `uvm_error("VALIDATION_FAIL", $sformatf("ML-DSA-44 KAT %0d: VERIFY_RES[%0d] vs reference c~ mismatch: actual=0x%08h, expected=0x%08h", ki, j, data, kat_VRES_arr[j]))
          end
          if (data !== hw_sig_arr[j]) begin
            `uvm_error("VALIDATION_FAIL", $sformatf("ML-DSA-44 KAT %0d: VERIFY_RES[%0d] vs hw signature mismatch: actual=0x%08h, expected=0x%08h", ki, j, data, hw_sig_arr[j]))
          end
        end else if (data !== 32'h0) begin
          `uvm_error("CTILDE_TAIL_NOT_ZERO", $sformatf("MLDSA_VERIFY_RES[%0d] is above the ML-DSA-44 c~ length but reads 0x%08h", j, data))
        end
      end

      // kat_VRES_arr is c~ zero extended to the category-5 register width,
      // which is exactly what MLDSA_VERIFY_RES should present here.
      check_verify_pass_ref(1, kat_VRES_arr);

      data = MLDSA_CTRL_ZEROIZE;
      reg_model.MLDSA_CTRL.write(status, data, UVM_FRONTDOOR, reg_model.default_map, this);
      if (status != UVM_IS_OK) `uvm_error("REG_WRITE", "Failed to write MLDSA_CTRL (zeroize after verify)");
    end

    `uvm_info("KAT", "ML-DSA-44 internal-mu keygen+sign+verify KAT completed", UVM_LOW);

  endtask

