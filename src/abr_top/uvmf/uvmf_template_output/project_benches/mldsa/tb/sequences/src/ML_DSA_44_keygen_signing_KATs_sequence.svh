        reg_model.MLDSA_MSG[j].write(status, kat_MSG_arr[j], UVM_FRONTDOOR, reg_model.default_map, this);
        if (status != UVM_IS_OK) `uvm_error("REG_WRITE", $sformatf("Failed to write MLDSA_MSG[%0d]", j));
      end

      // Deterministic signing: RND = 0, which is what the reference used.
