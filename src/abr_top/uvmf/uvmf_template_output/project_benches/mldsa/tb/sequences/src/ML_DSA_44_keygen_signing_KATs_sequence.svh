            `uvm_error("SIG_MISMATCH", $sformatf("ML-DSA-44 KAT %0d: SIGNATURE[%0d] mismatch: hw=0x%08h, ref=0x%08h", ki, j, data, kat_SIG_arr[j]))
          end
