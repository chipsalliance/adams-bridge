  // of mismatches instead of one report at its cause.
  function void check_size(string what, int got, int want);
    if (got != want) begin
      `uvm_fatal("KAT_MALFORMED", $sformatf("ML-DSA-44 %s vector is %0d dwords, expected %0d", what, got, want))
    end
  endfunction

  virtual task body();
    bit [31:0] hw_sig_arr [];

    reg_model.reset();
    data  = 0;
    ready = 0;
    valid = 0;
    #400;

    if (reg_model.default_map == null) begin
      `uvm_fatal("MAP_ERROR", "mldsa_uvm_rm.default_map is not initialized");
    end

    kat_SEED[0] = "86DD837F0ED6ECD2AAC053D6C9A549E24B1560F40DFC1B030284E00E3EA3FA69";
    kat_MSG[0]  = "EE4CDFF1DA2BE82EDA0E27FFE9EB7D4793DF0BE469216FCEDFEED915CAB3D6A2BCA26832C017D73398C8561113AFADA6B366D550E50D9508B80CEC42F7209518";
