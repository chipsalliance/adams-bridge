//
// The ML_DSA_44_externalmu_ACVP_KATs test supplies mu directly, so it
// never exercises the hardware's own mu derivation. That derivation is
// parameter-set dependent: tr = H(pk, 64) absorbs a 1312 byte public key at
// ML-DSA-44 instead of the 2592 bytes of category 5, and mu = H(tr || M)
// follows. This test is the only thing that pins that path at ML-DSA-44.
//
//   1. KeyGen + Sign from a seed and a 64 byte message, RND = 0
//   2. Compare PK and the signature against the reference
//   3. Check every aperture reads zero past its ML-DSA-44 length
//   4. Verify the hardware signature back, internal mu, and check
//      MLDSA_VERIFY_RES against c~ including its zero tail
//
// Vectors produced by tools/mldsa_ref.py, a FIPS 204 reference validated
// against the full NIST ACVP ML-DSA vector set (keyGen, sigGen and sigVer,
// all three parameter sets, zero failures) and cross-checked against the
// in-tree ML_DSA_44_keygen_KATs public and private keys.
//
//----------------------------------------------------------------------

class ML_DSA_44_keygen_signing_KATs_sequence extends mldsa_bench_sequence_base;

  `uvm_object_utils(ML_DSA_44_keygen_signing_KATs_sequence);

  // MLDSA_CTRL: CTRL[2:0] = 100 KEYGEN+SIGN / 011 VERIFY, PARAM_SET[8:7] = 2'b01
  localparam bit [31:0] MLDSA_CTRL_KEYGEN_SIGN = 32'h00000084;
