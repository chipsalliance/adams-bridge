            `uvm_error("PK_MISMATCH", $sformatf("ML-DSA-44 KAT %0d: PUBKEY[%0d] mismatch: hw=0x%08h, ref=0x%08h", ki, j, data, kat_PK_arr[j]))
          end
        end else if (data !== 32'h0) begin
          `uvm_error("TAIL_NOT_ZERO", $sformatf("MLDSA_PUBKEY[%0d] is past the ML-DSA-44 key length but reads 0x%08h", j, data))
        end
      end

