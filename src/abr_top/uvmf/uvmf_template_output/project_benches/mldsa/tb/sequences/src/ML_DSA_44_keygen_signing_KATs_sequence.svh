  localparam bit [31:0] MLDSA_CTRL_PARAM_ONLY  = 32'h00000080;

  // ML-DSA-44 FIPS 204 sizes, in dwords.
  localparam int PK_DWORDS     = 328;
  localparam int SIG_DWORDS    = 605;
  localparam int CTILDE_DWORDS = 8;

